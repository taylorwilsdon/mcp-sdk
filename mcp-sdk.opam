depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.2"}
  "eio" {>= "1.2"}
  "eio_main" {>= "1.2"}
  "jsont" {>= "0.2"}
  "bytesrw" {>= "0.1"}
  "digestif" {>= "1.2"}
  "base64" {>= "3.5"}
  "httpun-eio" {>= "0.2"}
  "alcotest" {with-test}
